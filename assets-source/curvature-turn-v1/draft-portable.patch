+    const travel = Math.min(distance,speed*dt), nx=x+Math.sin(yaw)*travel, nz=z+Math.cos(yaw)*travel;
+    if(blocked(nx,nz)||!lineClear([x,z],[nx,nz])) return tick*dt;
+    x=nx;z=nz;
+  }
+  return 1.5;
+}
