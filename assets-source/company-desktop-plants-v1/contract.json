{
  "schema": "company-desktop-plants-contract",
  "version": 1,
  "category": "decor",
  "mountRole": "plant-desktop-installation",
  "productionBranch": "plant-desktop-installation",
  "mount": "desk-surface",
  "parent": "desk.desktop",
  "mounting": { "origin": "bottom", "width": 0.35, "height": 0.55, "depth": 0.35, "reserveDesktopArea": true },
  "coordinates": { "units": "metres", "up": "+Y", "forward": "+Z" },
  "footprint": { "center": [0, 0], "halfSize": [0.175, 0.175], "blocking": false },
  "usePoints": [],
  "stateDefaults": {},
  "stockImport": {
    "format": "glb",
    "baseColorImage": "image/png",
    "uvSet": 0,
    "imageStorage": "embedded-bufferView",
    "maximumImageDimensionPixels": 2048,
    "maximumImageBytes": 2097152,
    "maximumImages": 3,
    "geometry": "static named pot, foliage and optional soil PBR meshes"
  }
}
