# Normalize text in the repository; use LF in working copies.
* text=auto eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary assets unchanged.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.fbx binary
*.blend binary
*.glb binary
*.psd binary
*.vrm binary
*.webm binary
# Preserve the downloaded comparison baseline byte-for-byte.
baseline/** -text
# Captured evidence hashes describe exact bytes, including recorder line endings.
evidence/** -text
# Full numerical frame traces stay readable/replayable, but omit enormous
# raw-line diffs; review the compact causal receipts and reproduction scripts.
evidence/female-acceleration-controller-law.json -diff
evidence/female-acceleration-narrow.json -diff
# Preserve the frozen candidate's Windows-authored input bytes for build-ID
# reproducibility. These remain readable text; only newline conversion is off.
prototype/src/equipment.js -text
prototype/public/assets/garments/equipment.json -text

# Candidate provenance manifest pins these exact source/evidence bytes.
assets-source/foundation-male/** -text
assets-source/foundation-male/publisher-page.html -diff
# Runtime identity hashes exact input bytes. Preserve authored input line endings
# across Windows checkouts; this does not change resource IDs or compatibility.
prototype/src/** -text
prototype/public/assets/** -text
prototype/index.html -text
# External research is an immutable UTF-8 snapshot, archived byte-for-byte.
docs/research/*.html -text

# Exact authored CRLF is retained above; CR is an end-of-line marker, not a
# trailing space. Continue checking actual spaces/tabs and extra blank EOF.
prototype/src/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
prototype/public/assets/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
evidence/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
prototype/*.html whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Source diagnostic receipts include exact-byte hashes of these generated inputs.
assets-source/forearm-collision-v1/** -text
assets-source/m1/offline-corrective/** -text
assets-source/forearm-collision-v1/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
assets-source/m1/offline-corrective/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.f32 binary
*.npz binary

# Reviewable forearm source bundle pins exact profile and evidence bytes.
assets-source/forearm-collision-v2/** -text
assets-source/forearm-collision-v2/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Archived raw diff includes original CRLF/context whitespace; retain its evidence hash.
assets-source/forearm-collision-v2/patch/c9-source-preserving-review.patch -whitespace
