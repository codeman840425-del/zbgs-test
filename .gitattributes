# Normalize text in the repository; use LF in working copies.
* text=auto eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary assets unchanged.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.fbx binary
*.blend binary
*.glb binary
*.psd binary
*.vrm binary
*.webm binary
# Preserve the downloaded comparison baseline byte-for-byte.
baseline/** -text
# Captured evidence hashes describe exact bytes, including recorder line endings.
evidence/** -text
# Preserve the frozen candidate's Windows-authored input bytes for build-ID
# reproducibility. These remain readable text; only newline conversion is off.
prototype/src/equipment.js -text
prototype/public/assets/garments/equipment.json -text

# Candidate provenance manifest pins these exact source/evidence bytes.
assets-source/foundation-male/** -text
assets-source/foundation-male/publisher-page.html -diff
# Runtime identity hashes exact input bytes. Preserve authored input line endings
# across Windows checkouts; this does not change resource IDs or compatibility.
prototype/src/** -text
prototype/public/assets/** -text
prototype/index.html -text
