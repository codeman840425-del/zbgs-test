{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "大楼楼层表",
  "type": "object",
  "required": [
    "version",
    "rows",
    "sliceW",
    "sliceH",
    "overlapPx"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "site": {
      "type": "string"
    },
    "sliceW": {
      "type": "integer",
      "minimum": 1
    },
    "sliceH": {
      "type": "integer",
      "minimum": 1
    },
    "overlapPx": {
      "type": "integer",
      "minimum": 0
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^fl_"
          },
          "key": {
            "type": "string",
            "pattern": "^bld_"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "直播间楼层的品类，引用 categories.id"
          }
        }
      }
    }
  }
}