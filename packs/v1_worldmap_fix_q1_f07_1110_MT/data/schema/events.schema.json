{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "随机事件表",
  "type": "object",
  "required": ["version", "rows"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "desc", "weight", "cooldownSec", "options"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ev_[a-z0-9_]+$" },
          "title": { "type": "string", "minLength": 1 },
          "desc": { "type": "string" },
          "weight": { "type": "number", "minimum": 0 },
          "cooldownSec": { "type": "integer", "minimum": 0 },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minFans": { "type": "integer", "minimum": 0 },
              "minDay": { "type": "integer", "minimum": 0 },
              "flags": { "type": "array", "items": { "type": "string" } }
            }
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["text", "effects"],
              "properties": {
                "text": { "type": "string" },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "value"],
                    "properties": { "type": { "type": "string" }, "value": { "type": "number" }, "target": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
