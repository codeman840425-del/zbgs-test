{
  "version": 1,
  "$comment": "家具摆放缩放表（初稿，scripts/gen-prop-scale.py 生成，改规则请改脚本后重跑）。说明见 docs/家具摆放缩放表说明.md",
  "baseline": {
    "desc": "基准 H = 主播全身立绘（char_streamerXX_full）内容包围盒高度的中位数（2x 源图像素）",
    "H": 1400,
    "samples": 12
  },
  "room": {
    "desc": "直播间底图 bg_room_rental_empty（2400² 2x）：主播站立时内容高度 = roomH 底图像素（约墙高 0.65）",
    "roomH": 620,
    "floor": {
      "desc": "地面网格（等距 3/4 视角，底图像素）：back=后墙角，L/R=左右墙脚方向单位格向量",
      "back": [
        1449,
        1266
      ],
      "u": [
        -160,
        43
      ],
      "v": [
        141,
        53
      ],
      "cols": 8,
      "rows": 6
    }
  },
  "grid": {
    "desc": "占地格子：1 格 = 地面上 u/v 方向各 1 个单位（约 0.26H，≈0.45m）。footprint.w 沿墙方向、d 向房间内；墙面/悬挂物 d=0 不占地面",
    "cell": 0.26
  },
  "layers": {
    "order": [
      "wall",
      "floor_flat",
      "floor",
      "desk",
      "hang"
    ],
    "rules": {
      "wall": "贴墙，按墙面 x 排序，永远在地面物件之后（底层）",
      "floor_flat": "地毯，贴地，在所有站立物件下面，不参与 y 排序",
      "floor": "地面物件与主播：按锚点（底边中心）y 升序绘制，y 大（离镜头近）的盖住 y 小的；同 y 按 x",
      "desk": "桌面物件：放在父家具（surface 字段 = 台面高度 / 家具高度）上，depth = 父 depth + 0.5，随父移动",
      "hang": "悬挂物：最高层，不参与 y 排序"
    }
  },
  "flipX": "美术统一朝向 = 正面朝左下（看到物件右侧面），适合靠右墙摆放；靠左墙摆放时运行时再镜像。flipX=true 表示该图朝向画反了，引擎先镜像统一朝向",
