{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "弹幕占位符演示取值",
  "type": "object",
  "required": [
    "version",
    "rows"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    }
  }
}