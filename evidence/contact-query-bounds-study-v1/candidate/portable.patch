+// Conservative same-query broad phase only; unsupported numbers keep the old path.
+// Units are metres in the orthonormal projected plane. Never a contact tolerance.
+export function prepareQueryTriangleBounds(projected, constants, out = {}) {
+  out.valid = false;
+  if (projected.length !== 6 || constants.length !== 7) return out;
+  let maxAbs = 1;
+  for (const value of projected) {
+    if (!Number.isFinite(value)) return out;
+    maxAbs = Math.max(maxAbs, Math.abs(value));
+  }
+  for (const value of constants) {
+    if (!Number.isFinite(value)) return out;
+    maxAbs = Math.max(maxAbs, Math.abs(value));
+  }
+  if (maxAbs > 100) return out;
+  const minU = Math.min(projected[0], projected[2], projected[4]);
+  const maxU = Math.max(projected[0], projected[2], projected[4]);
+  const minV = Math.min(projected[1], projected[3], projected[5]);
+  const maxV = Math.max(projected[1], projected[3], projected[5]);
+  const span = Math.max(maxU - minU, maxV - minV);
+  if (span < 1e-6 || span > 10 ||
+      Math.abs(constants[6]) <= Math.max(1e-12, span * span * 1e-6)) return out;
+  out.minU = minU; out.maxU = maxU; out.minV = minV; out.maxV = maxV;
+  out.maxAbs = maxAbs; out.valid = true;
+  return out;
+}
+export function prepareQueryRailBounds(su, sv, eu, ev, out = {}) {
+  out.valid = false;
+  if (!Number.isFinite(su) || !Number.isFinite(sv) ||
+      !Number.isFinite(eu) || !Number.isFinite(ev)) return out;
+  const maxAbs = Math.max(1, Math.abs(su), Math.abs(sv), Math.abs(eu), Math.abs(ev));
+  if (maxAbs > 100 || Math.max(Math.abs(eu - su), Math.abs(ev - sv)) > 10) return out;
+  out.minU = Math.min(su, eu); out.maxU = Math.max(su, eu);
+  out.minV = Math.min(sv, ev); out.maxV = Math.max(sv, ev);
+  out.maxAbs = maxAbs; out.valid = true;
+  return out;
+}
+export function queryBoundsRejects(rail, triangle) {
+  if (!rail.valid || !triangle.valid) return false;
+  const margin = 1e-6 + 64 * Number.EPSILON * Math.max(rail.maxAbs, triangle.maxAbs);
+  return rail.maxU < triangle.minU - margin || rail.minU > triangle.maxU + margin ||
+    rail.maxV < triangle.minV - margin || rail.minV > triangle.maxV + margin;
+}
