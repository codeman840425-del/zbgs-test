      "centerX": -0.05,
      "smallSize": [
        0.3,
        0.34,
        0.26
      ],
      "prompt": "Two real complete original square tables at different heights, with independent ground contact. Main table center -.05, small center from nested.smallOffsetX; retain each top/four legs/tie frame. Static arrangement.",
      "sourceRegions": {
        "sourceNodes": [
          "tableCoffeeSquare(Clone)"
        ],
        "retained": "Two complete positive-area copies, each independently bottom-centred and scaled. Only main top pair moves to side-table-top. Small table is a static complete grounded instance."
      }
