      "id": "round",
      "source": "tableRound",
      "label": "圆几 · 原柱架圆台板",
      "size": [
        null,
        0.5,
        null
      ],
      "centerX": 0,
      "prompt": "Retain the original real pedestal/braces/base; replace only the measured six-sided tabletop region with a 48-sided circular slab and close the actual support cut. Radius .26m, top .5m, slab bottom from the original measured underside.",
      "sourceRegions": {
        "sourceNodes": [
          "tableRound(Clone)"
        ],
        "retained": "Original positive-area source faces below measured tabletop underside, clipped at that plane. Original hexagonal slab and complete old underside are removed. Boundary loops at the actual cut are closed with upward triangles.",
        "new": "48-sided circular slab at source-derived underside and top .5, with non-overlapping annular top plus rectangular two-triangle patch."
      }
    },
    {
      "id": "square",
      "source": "cabinetBed",
