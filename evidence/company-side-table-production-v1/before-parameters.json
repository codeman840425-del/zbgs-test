        "sourceNodes": [
          "cabinetBed(Clone)",
          "Mesh_door",
          "Mesh_door_1"
        ],
        "retained": "All positive-area body, fixed door and handle faces. Original world matrices baked once; body top pair is split into side-table-top with no duplicate."
      }
    },
    {
      "id": "nested",
      "source": "tableCoffeeSquare",
      "label": "套几 · 双桌错叠",
